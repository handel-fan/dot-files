layout {
  tab name="build" {
    pane size=1 borderless=true {
      command "bash" "-lc" "echo \"Run dir: $RUN_DIR\"; echo \"Logs: $RUN_DIR/build.log\""
    }
    pane {
      command "bash" "-lc" "cd \"$WORKDIR\" && ./build_llvm.sh 2>&1 | tee \"$RUN_DIR/build.log\""
    }
  }

  tab name="telemetry" {
    pane split_direction="vertical" {
      pane size="50%" {
        command "bash" "-lc" "cd \"$WORKDIR\" && ./telemetry.sh 2>&1 | tee \"$RUN_DIR/telemetry.log\""
      }
      pane {
        command "bash" "-lc" "tail -n 200 -f \"$RUN_DIR/telemetry.log\""
      }
    }
  }
}

